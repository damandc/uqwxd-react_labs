# ─── BFF (server-side only) — NEVER commit real values ───
# Provider keys live ONLY here, in your serverless secret manager.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...   # full-access; server only
AURA_MODEL=claude-opus-4-8

# ─── Client (safe to expose) ───
# The anon/publishable key is designed to be public; RLS is what protects data.
# Set these as EXPO_PUBLIC_* so Expo inlines them into the client build.
EXPO_PUBLIC_BFF_URL=https://your-bff.example.com
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...
